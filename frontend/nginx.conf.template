# Serves the built SPA and proxies the API and the interview WebSocket to assessment-api,
# so the browser only ever talks to one origin.
#
# This file is an nginx *template*: the official nginx image substitutes ${API_UPSTREAM}
# (set in the Dockerfile / compose) into /etc/nginx/conf.d/default.conf at container start.
# Every other $name below is a normal nginx variable and is left alone.

# Lets the WebSocket upgrade through, and keeps plain requests as normal HTTP.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker's embedded DNS. With a variable in proxy_pass, nginx looks the name up again at
# request time (honouring this short TTL) instead of once at startup, so a recreated API
# container is found automatically. Resolving only at startup left nginx talking to a stale
# address after redeploys, which showed up as "502 / connection refused".
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # host:port of assessment-api. Defaults to an alias that exists only on this stack's own
    # compose network (see docker-compose.prod.yml). The plain service name "assessment-api"
    # is NOT safe on Dokploy: it also exists on the network shared with every other project,
    # so it can resolve to someone else's container.
    set $api_upstream ${API_UPSTREAM};

    # Bulk student/problem imports upload spreadsheets and test-case files.
    client_max_body_size 20m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Append to the chain rather than overwrite it, so the real client address survives
        # the Cloudflare -> Traefik -> nginx hops once the API is told to trust them.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # Code runs can take up to ~25s with wait=true; leave headroom above that.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location /ws/interview {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Interview rooms stay open for the length of an interview.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Hashed build assets never change under the same name.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must always be revalidated, or users keep an old bundle after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Single-page app: unknown paths go to the router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
