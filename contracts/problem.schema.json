{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Problem",
  "description": "A programming problem",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": ["Easy", "Medium", "Hard"]
    },
    "problemType": {
      "type": "string",
      "enum": ["function", "stdin", "mcq", "subjective"]
    },
    "functionName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": { "type": "string", "minLength": 1 }
        },
        "required": ["name", "type"],
        "additionalProperties": false
      }
    },
    "returnType": {
      "type": "string",
      "minLength": 1
    },
    "timeLimitMs": {
      "type": "integer",
      "minimum": 100
    },
    "memoryLimitMb": {
      "type": "integer",
      "minimum": 32
    },
    "compareConfig": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["EXACT", "STRUCTURAL"] },
        "floatTolerance": { "type": "number", "minimum": 0 },
        "orderInsensitive": { "type": "boolean" },
          "requireDeepCopy": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "array",
            "items": {}
          },
          "expected": {},
          "isSample": {
            "type": "boolean"
          },
          "isHidden": {
            "type": "boolean"
          }
        },
        "required": ["inputs", "expected"],
        "additionalProperties": false
      }
    },
    "testsJSON": {
      "type": "string"
    },
    "inputFormat": {
      "type": "string"
    },
    "outputFormat": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isPremium": {
      "type": "boolean"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "isCorrect": { "type": "boolean" }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    "allowMultipleAnswers": {
      "type": "boolean"
    },
    "maxWords": {
      "type": "integer",
      "minimum": 1
    },
    "rubricNotes": {
      "type": "string"
    },
    "referenceSolution": {
      "type": "string"
    },
    "solutionLanguage": {
      "type": "string",
      "enum": ["javascript", "typescript", "python", "java", "go", "cpp", "c", "csharp", "rust", "ruby", "php", "kotlin"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["title", "description", "difficulty"],
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "not": { "required": ["problemType"] } },
          { "properties": { "problemType": { "const": "function" } }, "required": ["problemType"] }
        ]
      },
      "then": {
        "required": ["functionName", "parameters", "returnType", "testCases"]
      }
    },
    {
      "if": {
        "properties": { "problemType": { "const": "stdin" } },
        "required": ["problemType"]
      },
      "then": {
        "required": ["testCases", "referenceSolution", "solutionLanguage"]
      }
    },
    {
      "if": {
        "properties": { "problemType": { "const": "mcq" } },
        "required": ["problemType"]
      },
      "then": {
        "required": ["options"]
      }
    }
  ]
}
